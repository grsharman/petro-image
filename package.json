{
  "name": "petro-image",
  "version": "0.1.1",
  "description": "Deep zoom petrographic images with OpenSeaDragon",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder",
    "clean": "rimraf dist node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grsharman/petro-image.git"
  },
  "author": "Glenn R. Sharman and Jonathan P. Sharman",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/grsharman/petro-image/issues"
  },
  "homepage": "https://github.com/grsharman/petro-image",
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.4.0",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.sharman.petro-image",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "productName": "petro-image",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "npmRebuild": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "petro-image"
    },
    "publish": null
  }
}
